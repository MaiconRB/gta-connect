# Copie este arquivo para .env e ajuste a senha antes de subir o docker-compose.
# O .env real NUNCA deve ser commitado (já está no .gitignore).

# Senha do usuário 'sa' do SQL Server.
# Requisito do SQL Server: mínimo 8 caracteres, com letras maiúsculas, minúsculas, números e símbolos.
SQLSERVER_SA_PASSWORD=<defina-uma-senha-forte-aqui>
